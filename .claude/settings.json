{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-secret-files.js",
            "statusMessage": "비밀 파일 여부 확인 중..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-dangerous-bash.js",
            "statusMessage": "위험한 명령어인지 확인 중..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/guard-git-secrets.js",
            "statusMessage": "커밋/푸시에 비밀키가 있는지 확인 중..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{const j=JSON.parse(d);const f=(j.tool_response&&j.tool_response.filePath)||(j.tool_input&&j.tool_input.file_path);if(f)process.stdout.write(f+String.fromCharCode(10));}catch(e){}})\" | { read -r f; case \"$f\" in *.ts|*.tsx|*.js|*.jsx) npx eslint --fix \"$f\";; esac; } 2>/dev/null || true",
            "statusMessage": "코드 정리 중 (eslint --fix)..."
          }
        ]
      }
    ]
  }
}
